# もも声サービス アダプタ 設定サンプル
# 使うときは `cp .env.example .env` してから値を編集してね。

# Style-Bert-VITS2 本体（server_fastapi.py）のURL。既定ポートは 5000。
SBV2_URL=http://127.0.0.1:5000

# もも の学習済みモデル指定。
#  - MOMO_MODEL_NAME を入れるとそちらが優先される（モデルのフォルダ名）。
#  - 空なら MOMO_MODEL_ID（/models/info で確認できる番号）を使う。
MOMO_MODEL_NAME=
MOMO_MODEL_ID=0
MOMO_SPEAKER_ID=0

# 既定スタイルとスタイルの強さ。アプリ側から style を送れば都度上書きされる。
MOMO_DEFAULT_STYLE=Neutral
MOMO_STYLE_WEIGHT=1.0

# 合成言語（日本語は JP）。
MOMO_LANGUAGE=JP

# CORS 許可オリジン。安全のため本番は自分のアプリURLに絞るのがおすすめ。
#  例: ALLOW_ORIGINS=https://your-momo-app.example.com
#  全許可にするなら * （個人利用なら手早いがURLを知られると誰でも叩ける点に注意）
ALLOW_ORIGINS=*

# このアダプタ自身の待受。
ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8000
